# Provide CORS origins as a JSON array.
POLICYDESK_CORS_ORIGINS=["http://localhost:5173"]
POLICYDESK_SUPABASE_URL=https://your-project.supabase.co
POLICYDESK_SUPABASE_ANON_KEY=your-supabase-anon-key
POLICYDESK_SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Optional but recommended: generate with `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
# Keep stable across deployments so existing join codes remain recoverable.
# POLICYDESK_JOIN_CODE_ENCRYPTION_KEY=
POLICYDESK_APP_BASE_URL=http://localhost:5173
