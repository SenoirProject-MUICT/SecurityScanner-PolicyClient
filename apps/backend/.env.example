# Provide CORS origins as a JSON array.
POLICYDESK_CORS_ORIGINS=["http://localhost:5173"]
POLICYDESK_SUPABASE_URL=https://your-project.supabase.co
POLICYDESK_SUPABASE_ANON_KEY=your-supabase-anon-key
POLICYDESK_SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Optional but recommended: generate with `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
# Keep stable across deployments so existing join codes remain recoverable.
# POLICYDESK_JOIN_CODE_ENCRYPTION_KEY=
POLICYDESK_APP_BASE_URL=http://localhost:5173
# GitHub App used for repository integrations. Create it under GitHub Settings > Developer settings > GitHub Apps.
# The numeric App ID shown on the app's settings page.
# POLICYDESK_GITHUB_APP_ID=
# The app's URL name, as in https://github.com/apps/<slug>.
# POLICYDESK_GITHUB_APP_SLUG=
# OAuth client ID; used to confirm the installing user can access the installation.
# POLICYDESK_GITHUB_APP_CLIENT_ID=
# OAuth client secret; also signs the install state value.
# POLICYDESK_GITHUB_APP_CLIENT_SECRET=
# The app's private key PEM. A single line with literal \n separators is accepted.
# POLICYDESK_GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# The webhook secret entered on the app's settings page.
# POLICYDESK_GITHUB_WEBHOOK_SECRET=
# Override only for GitHub Enterprise Server, for example https://github.example.com/api/v3.
# POLICYDESK_GITHUB_API_URL=https://api.github.com
